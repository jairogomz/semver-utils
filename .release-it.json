{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": false,
    "commitMessage": "chore(release): release semverUtils v.${version} [skip ci]",
    "tagName": "semverUtils-v.${version}",
    "push": true
  },
  "github": {
    "release": false,
    "releaseName": "Release: semverUtils v.${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "plugins": {
    "@release-it/bumper": {
      "in": ["package.json"]
    },
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          },
          {
            "type": "perf",
            "section": "Performance",
            "effect": "hidden"
          },
          {
            "type": "docs",
            "section": "Documentation",
            "effect": "hidden"
          },
          {
            "type": "style",
            "section": "Style",
            "effect": "hidden"
          },
          {
            "type": "refactor",
            "section": "Refactors",
            "effect": "hidden"
          },
          {
            "type": "test",
            "section": "Tests",
            "effect": "hidden"
          },
          {
            "type": "build",
            "section": "Build",
            "effect": "hidden"
          },
          {
            "type": "ci",
            "section": "CI configuration",
            "effect": "hidden"
          },
          {
            "type": "chore",
            "section": "Chore",
            "effect": "hidden"
          },
          {
            "type": "revert",
            "section": "Reverts",
            "effect": "hidden"
          }
        ]
      }
    }
  },
  "hooks": {
    "after:bump": "echo 'Version bumped to ${version}'"
  }
}